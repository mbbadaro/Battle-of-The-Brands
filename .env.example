# Supabase project settings -> API. Both values are safe to expose to the browser:
# the anon key only grants what the row level security policies and RPC role checks allow.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# The Vercel Supabase integration may create NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead; either works.
# Never put the service_role key in this app. It is not needed.
